{
  "name": "xiaomi-remote-2-pro",
  "version": "1.5.6",
  "description": "Voice VibeCoding — 语音氛围编程 / 小米·T1·V60 遥控器桥接 (Rust + Tauri 2 + Vue 3)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:winuhid-install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-winuhid-install.ps1",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --test config_voice_release --test voice_chord_and_release --test voice_chord_sanitize --test voice_first_packet --test ime_voice_wake_route",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-notification": "^2.0.0",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "pinia": "^2.1.7",
    "vue": "^3.4.0",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.0.0"
  }
}
